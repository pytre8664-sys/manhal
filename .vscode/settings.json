{
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "files.eol": "\n",
  "files.encoding": "utf8",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "editor.formatOnSave": false,
  "html.format.wrapLineLength": 120,
  "javascript.format.semicolons": "insert",
  "files.associations": {
    "*.html": "html",
    "*.css": "css",
    "*.js": "javascript"
  }
}
